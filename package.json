{
  "name": "showcase-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:personal": "pnpm --filter personal dev",
    "dev:company": "pnpm --filter company dev",
    "dev:janica": "pnpm --filter janica dev",
    "build:personal": "pnpm --filter personal build",
    "build:company": "pnpm --filter company build",
    "build:janica": "pnpm --filter janica build",
    "build": "pnpm build:personal && pnpm build:company && pnpm build:janica",
    "check": "pnpm -r check"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.11.0"
}
